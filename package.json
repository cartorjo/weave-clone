{
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/main.css -o ./css/site.css --minify",
    "watch:css": "tailwindcss -i ./styles/main.css -o ./css/site.css --watch",
    "assemble": "node assemble.mjs",
    "check:content": "node tools/check-content.mjs",
    "import:feedback-images": "node tools/import-feedback-assets.mjs",
    "build:img": "node tools/optimize-images.mjs",
    "build:brand-img": "node tools/optimize-brand-images.mjs",
    "check": "npm run build && npm run check:content && npm run check:meta && npm run check:copy && git diff --exit-code",
    "watch:html": "node --watch --watch-path=sections --watch-path=pages --watch-path=partials --watch-path=js assemble.mjs",
    "build": "npm run assemble && npm run build:css",
    "serve": "serve . -l 8080",
    "start": "node tools/build-dist.mjs && serve dist -l ${PORT:-8080}",
    "dev": "concurrently \"npm:watch:css\" \"npm:watch:html\" \"npm run serve\"",
    "build:dist": "node tools/build-dist.mjs",
    "check:copy": "node tools/check-copy.mjs",
    "copy:accept": "node tools/check-copy.mjs --accept",
    "check:meta": "node tools/check-meta.mjs",
    "smoke": "node tools/visual/smoke.mjs",
    "visual:snapshot": "node tools/visual/snapshot.mjs",
    "visual:diff": "node tools/visual/diff.mjs",
    "visual:pixdiff": "node tools/visual/pixdiff.mjs",
    "css:shadowed": "node tools/visual/shadowed.mjs",
    "visual:components": "node tools/visual/components.mjs",
    "contrast": "node tools/visual/contrast.mjs"
  },
  "dependencies": {
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "4.13.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "24.43.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
