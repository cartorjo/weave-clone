{
  "directoryListing": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/case-studies/technische-dokumentation",
      "destination": "/case-studies/technische-dokumentation-halbleiter/",
      "type": 301
    },
    {
      "source": "/case-studies/fahrzeugfunktionen",
      "destination": "/case-studies/funktionsbetreuung-infotainment/",
      "type": 301
    },
    {
      "source": "/case-studies",
      "destination": "/branchen/",
      "type": 301
    },
    {
      "source": "/about",
      "destination": "/about-us/",
      "type": 301
    },
    {
      "source": "/contact",
      "destination": "/kontakt/",
      "type": 301
    },
    {
      "source": "/join-us",
      "destination": "/karriere/",
      "type": 301
    },
    {
      "source": "/vacancies",
      "destination": "/karriere/",
      "type": 301
    },
    {
      "source": "/vacancies/*",
      "destination": "/karriere/",
      "type": 301
    },
    {
      "source": "/industries",
      "destination": "/branchen/",
      "type": 301
    },
    {
      "source": "/industries/*",
      "destination": "/branchen/",
      "type": 301
    },
    {
      "source": "/insights",
      "destination": "/branchen/",
      "type": 301
    },
    {
      "source": "/insights/*",
      "destination": "/branchen/",
      "type": 301
    },
    {
      "source": "/solutions",
      "destination": "/portfolio/",
      "type": 301
    },
    {
      "source": "/solutions/*",
      "destination": "/portfolio/",
      "type": 301
    },
    {
      "source": "/team-member",
      "destination": "/about-us/#management",
      "type": 301
    },
    {
      "source": "/team-member/*",
      "destination": "/about-us/#management",
      "type": 301
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "type": 301
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "type": 301
    },
    {
      "source": "/en/terms",
      "destination": "/en/terms-of-use/",
      "type": 301
    },
    {
      "source": "/en/disclaimer",
      "destination": "/en/legal-notice/",
      "type": 301
    },
    {
      "source": "/en/about",
      "destination": "/en/about-us/",
      "type": 301
    },
    {
      "source": "/en/industries/*",
      "destination": "/en/industries/",
      "type": 301
    },
    {
      "source": "/en/insights",
      "destination": "/en/industries/",
      "type": 301
    },
    {
      "source": "/en/insights/*",
      "destination": "/en/industries/",
      "type": 301
    },
    {
      "source": "/en/join-us",
      "destination": "/en/careers/",
      "type": 301
    },
    {
      "source": "/en/solutions",
      "destination": "/en/services/",
      "type": 301
    },
    {
      "source": "/en/solutions/*",
      "destination": "/en/services/",
      "type": 301
    },
    {
      "source": "/en/vacancies",
      "destination": "/en/careers/",
      "type": 301
    },
    {
      "source": "/en/vacancies/*",
      "destination": "/en/careers/",
      "type": 301
    },
    {
      "source": "/en/team-member",
      "destination": "/en/about-us/#management",
      "type": 301
    },
    {
      "source": "/en/team-member/*",
      "destination": "/en/about-us/#management",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self' mailto:; base-uri 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "**/*.@(avif|webp|jpg|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "**/*.avif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/avif"
        }
      ]
    }
  ]
}
